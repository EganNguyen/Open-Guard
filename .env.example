# =============================================================
# WARNING: Local Development Only
# -------------------------------------------------------------
# This .env.example contains safe, non-production secrets for local
# development and testing. DO NOT use these values in staging or
# production. If you deploy to a real environment, generate and
# provision new secrets and remove any copied .env files from source
# control.
# To run locally: copy this file to .env (cp .env.example .env)
# =============================================================

# PostgreSQL
POSTGRES_PASSWORD=localdev-postgres-password
DATABASE_URL=postgres://openguard:localdev-postgres-password@postgres:5432/openguard?sslmode=disable
IAM_DATABASE_URL=postgres://openguard:localdev-postgres-password@postgres:5432/openguard_iam?sslmode=disable
DLP_DATABASE_URL=postgres://openguard:localdev-postgres-password@postgres:5432/openguard_dlp?sslmode=disable
REGISTRY_DATABASE_URL=postgres://openguard:localdev-postgres-password@postgres:5432/openguard_registry?sslmode=disable
POLICY_DATABASE_URL=postgres://openguard:localdev-postgres-password@postgres:5432/openguard_policy?sslmode=disable
COMPLIANCE_DATABASE_URL=postgres://openguard:localdev-postgres-password@postgres:5432/openguard?sslmode=disable
TASK_DATABASE_URL=postgres://openguard:localdev-postgres-password@postgres:5432/openguard?sslmode=disable
WEBHOOK_DATABASE_URL=postgres://openguard:localdev-postgres-password@postgres:5432/openguard_webhook?sslmode=disable

# JWT Key ring (JSON array, see shared/crypto/jwt.go for format)
# Example local key (base64 64). Generate your own with: openssl rand -base64 64
JWT_KEYS=[{"kid":"v1","secret":"n1mK9s8v2pQe5rT4yZb7uA6xC0dF3gH5jK2lM9oPqR4sT6uV7wX8yZ0aB1cD2eF3","algorithm":"HS256","status":"active"}]

# AES Encryption Key ring (for MFA secrets)
# Example local key (base64 32). Generate your own with: openssl rand -base64 32
AES_KEYS=[{"kid":"v1","key":"bG9jYWxkZXYtYWVzLWtleS1leGFtcGxlLTIzNDU2","status":"active"}]

# Audit HMAC (hash chain integrity)
# Example local secret (hex 32). Generate with: openssl rand -hex 32
AUDIT_SECRET_KEY=9f1c2a3b4d5e6f7098a1b2c3d4e5f6079a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4

# MFA Backup Code HMAC
# Example local secret (hex 32). Generate with: openssl rand -hex 32
IAM_MFA_BACKUP_CODE_HMAC_SECRET=3a4b5c6d7e8f90123456789abcdef0123456789abcdef0123456789abcdef01

# SIEM Webhook HMAC
# Example local secret (hex 32). Generate with: openssl rand -hex 32
ALERTING_SIEM_WEBHOOK_HMAC_SECRET=a1b2c3d4e5f60718293a4b5c6d7e8f90123456789abcdef0123456789abcdef0

# Redis
REDIS_URL=redis://redis:6379/0

# Kafka
KAFKA_BROKERS=kafka:29092

# Internal API key (service-to-service)
# Example local API key. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=5f2e1d3c4b6a7980a1b2c3d4e5f60718293a4b5c6d7e8f90123456789abcdef0

# SCIM Provisioning Authentication
# Format: JSON array of objects with "token" and "org_id"
SCIM_TOKENS=[{"token":"d4c3b2a1908f7e6d5c4b3a2910f8e7d6","org_id":"00000000-0000-0000-0000-000000000000"}]

# Compliance Service
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=default
CLICKHOUSE_BULK_FLUSH_ROWS=5000
CLICKHOUSE_BULK_FLUSH_MS=2000
COMPLIANCE_REPORT_MAX_CONCURRENT=10
COMPLIANCE_SIGNING_KEY_PATH=

# S3/MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=compliance-reports
S3_REGION=us-east-1

# Threat Detection
MAXMIND_LICENSE_KEY=
GEOLITE2_DB_PATH=/data/GeoLite2-City.mmdb
THREAT_MAX_FAILED_LOGINS=11
THREAT_GEO_CHANGE_THRESHOLD_KM=500
THREAT_OFF_HOURS_START=22
THREAT_OFF_HOURS_END=6

# Localstack
LOCALSTACK_AUTH_TOKEN=ls-key

# -------------------------------------------------------------
# Local Dev Notes
# 1) Copy this file to .env: cp .env.example .env
# 2) To regenerate secrets locally, use the following commands:
#    - Base64 (64 bytes): openssl rand -base64 64
#    - Base64 (32 bytes): openssl rand -base64 32
#    - Hex (32 bytes): openssl rand -hex 32
# 3) Never commit a real .env to source control. Treat this file
#    as readable example data for local development only.
# -------------------------------------------------------------
